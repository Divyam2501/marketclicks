# Alpaca Markets (paper trading keys work for market data)
# https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here

# Confluent Cloud (Kafka cluster credentials)
CONFLUENT_BOOTSTRAP_SERVERS=pkc-xxxxx.region.provider.confluent.cloud:9092
CONFLUENT_API_KEY=your_confluent_api_key_here
CONFLUENT_API_SECRET=your_confluent_api_secret_here
