# Reference only: the keys the alpaca-feed pod expects. Don't fill this in.
# The real Secret is created directly from the local .env, so no secret file
# ever exists on disk:
#
#   kubectl create secret generic alpaca-feed-env --from-env-file=.env
#
# To rotate: delete and recreate it, then restart the pod:
#   kubectl delete secret alpaca-feed-env
#   kubectl create secret generic alpaca-feed-env --from-env-file=.env
#   kubectl rollout restart deployment/alpaca-feed
apiVersion: v1
kind: Secret
metadata:
  name: alpaca-feed-env
type: Opaque
stringData:
  ALPACA_API_KEY: "<from .env>"
  ALPACA_API_SECRET: "<from .env>"
  CONFLUENT_BOOTSTRAP_SERVERS: "<from .env>"
  CONFLUENT_API_KEY: "<from .env>"
  CONFLUENT_API_SECRET: "<from .env>"
